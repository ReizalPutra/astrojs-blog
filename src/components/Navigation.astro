---
type NavItem = {
    url: string;
    title: string;
};

const navItems: NavItem[] = [
    { url: "/", title: "Home" },
    { url: "/about/", title: "About" },
    { url: "/blog/", title: "Blog" },
];
---

<div id="main-menu" class="nav-links">
    {navItems.map((item) => (
        <a href={item.url}>{item.title}</a>
    ))}
</div>
